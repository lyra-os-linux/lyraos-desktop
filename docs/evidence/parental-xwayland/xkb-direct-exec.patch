     return iop;
+}
+
+/* Structured callers never invoke a command interpreter or search PATH. */
+void *
+PopenArgv(const char *const argv[], const char *type)
+{
+    if (argv == NULL || argv[0] == NULL)
+        return NULL;
+    return PopenInternal(argv[0], argv, type);
+}
+
+/* Preserve the executable and argv semantics for existing shell callers. */
+void *
+Popen(const char *command, const char *type)
+{
+    const char *const argv[] = {"sh", "-c", command, NULL};
+
+    if (command == NULL)
+        return NULL;
+    return PopenInternal("/bin/sh", argv, type);
 }
 
