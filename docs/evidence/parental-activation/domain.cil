; Disposable execution probe. NOT a desktop/account policy.
(type lyra_parental_probe_t)
(typeattributeset domain (lyra_parental_probe_t))
(roletype system_r lyra_parental_probe_t)
(type lyra_parental_probe_exec_t)
(typeattributeset file_type (lyra_parental_probe_exec_t))
(typeattributeset exec_type (lyra_parental_probe_exec_t))
(allow lyra_parental_probe_t file_type (dir (search getattr)))
(allow lyra_parental_probe_t file_type (lnk_file (read getattr)))
; Read/map are deliberately broad in this execution-only experiment.
(allow lyra_parental_probe_t file_type (file (read open getattr map)))
(allow lyra_parental_probe_t lyra_parental_probe_exec_t (file (execute execute_no_trans entrypoint)))
(allow lyra_parental_probe_t lib_t (file (execute)))
(allow lyra_parental_probe_t ld_so_t (file (execute)))
(allow lyra_parental_probe_t domain (fd (use)))
(allow lyra_parental_probe_t domain (fifo_file (read write getattr ioctl)))
(allow lyra_parental_probe_t file_type (fifo_file (read write getattr ioctl)))
(allow lyra_parental_probe_t domain (process (sigchld)))
(allow lyra_parental_probe_t self (process (getattr)))
; Entry is allowed only from the disposable evidence service for this probe.
(allow unconfined_service_t lyra_parental_probe_t (process (transition)))
(allow lyra_parental_probe_t proc_type (dir (search getattr)))
(allow lyra_parental_probe_t proc_type (file (read open getattr)))

; Experimental PAM entry role. Not a complete login/session policy.
(role lyra_parental_r)
(roletype lyra_parental_r lyra_parental_probe_t)
(roleallow system_r lyra_parental_r)
(allow init_t lyra_parental_probe_t (process (transition)))
(allow local_login_t lyra_parental_probe_t (process (transition)))
(allow xdm_t lyra_parental_probe_t (process (transition)))

; Test harness only: normal-account control from the evidence service.
(allow unconfined_service_t unconfined_t (process (transition)))

; Exact key-creation permission needed by PAM in user@.service.
(allow init_t lyra_parental_probe_t (key (create)))

; Permit the user-manager executable, not generic bin_t/shell_exec_t.
(allow lyra_parental_probe_t init_exec_t (file (entrypoint execute execute_no_trans)))
; Official policy requires a login target for UID/role transitions from init_t.
(typeattributeset process_user_target (lyra_parental_probe_t))
; Keyring lifecycle in PAM, scoped to keys labelled with this fixture domain.
(allow init_t lyra_parental_probe_t (key (write setattr)))
; Read-only manager discovery and configuration.
(allow lyra_parental_probe_t cgroup_t (filesystem (getattr)))
(allow lyra_parental_probe_t systemd_conf_t (dir (read open)))
(allow lyra_parental_probe_t init_t (dir (search getattr)))
(allow lyra_parental_probe_t init_t (file (read open getattr)))
(allow lyra_parental_probe_t nsfs_t (file (getattr)))
; Runtime data remains non-executable; DAC still isolates the private UID dir.
(allow lyra_parental_probe_t self (process (setfscreate)))
(allow lyra_parental_probe_t user_tmp_t (dir (read open write add_name remove_name create setattr)))
(allow lyra_parental_probe_t user_tmp_t (file (create write append unlink setattr)))
; Local notifications/logging; no network socket or generic process execution.
(allow lyra_parental_probe_t self (unix_dgram_socket (create connect read write getattr getopt setopt bind shutdown)))
(allow lyra_parental_probe_t init_t (unix_dgram_socket (sendto)))
(allow lyra_parental_probe_t syslogd_t (unix_dgram_socket (sendto)))
(allow lyra_parental_probe_t init_var_run_t (sock_file (write)))
(allow lyra_parental_probe_t syslogd_var_run_t (sock_file (write)))
(allow lyra_parental_probe_t user_tmp_t (fifo_file (create open unlink setattr)))
(allow lyra_parental_probe_t user_tmp_t (sock_file (create write unlink setattr)))
(allow lyra_parental_probe_t user_tmp_t (file (link)))
; Inherited service-manager stdio, not permission to connect to its control API.
(allow lyra_parental_probe_t init_t (unix_stream_socket (read write getattr getopt)))
; User manager's cgroup subtree; normal ownership/delegation still applies.
(allow lyra_parental_probe_t cgroup_t (dir (read open write add_name remove_name create rmdir)))
(allow lyra_parental_probe_t cgroup_t (file (write)))
; Read packaged unit directories and own local manager sockets.
(allow lyra_parental_probe_t systemd_unit_file_t (dir (read open)))
(allow lyra_parental_probe_t self (unix_stream_socket (create read write bind listen accept connect getattr getopt setopt shutdown)))

; Session resource experiment: exact AVCs from diagnostics.json.
(allow lyra_parental_probe_t session_dbusd_tmp_t (sock_file (create write getattr setattr unlink)))
(allow lyra_parental_probe_t user_tmp_t (sock_file (getattr)))
(allow lyra_parental_probe_t user_tmp_t (dir (rmdir)))
(allow lyra_parental_probe_t user_tmp_t (lnk_file (create unlink setattr)))
(allow lyra_parental_probe_t cgroup_t (dir (setattr)))
(allow lyra_parental_probe_t cgroup_t (file (watch create)))
; Own memfd/tmpfs data: dedicated non-executable type, not all tmpfs writes.
(type lyra_parental_runtime_t)
(typeattributeset file_type (lyra_parental_runtime_t))
(typetransition lyra_parental_probe_t tmpfs_t file lyra_parental_runtime_t)
(allow lyra_parental_probe_t lyra_parental_runtime_t (file (create write append setattr unlink)))

; Keep these official service executables inside the restricted domain.
; No transition to an unconfined/session-wide upstream domain is introduced.
(allow lyra_parental_probe_t dbusd_exec_t (file (execute execute_no_trans)))
(allow lyra_parental_probe_t systemd_tmpfiles_exec_t (file (execute execute_no_trans)))
(allow lyra_parental_probe_t systemd_systemctl_exec_t (file (execute execute_no_trans)))

; systemd execution handoff and journal stream (observed diagnostics-1).
(allow lyra_parental_probe_t self (unix_dgram_socket (sendto)))
(allow lyra_parental_probe_t syslogd_t (unix_stream_socket (connectto)))
(allow lyra_parental_probe_t user_tmp_t (lnk_file (rename)))

; Broker configuration discovery and own user-manager control socket.
(allow lyra_parental_probe_t dbusd_etc_t (dir (read open watch)))
(allow lyra_parental_probe_t self (unix_stream_socket (connectto)))

; Read and watch packaged D-Bus service directories under /usr/share.
(allow lyra_parental_probe_t usr_t (dir (read open watch)))

; libselinux must read real userspace class definitions, not fail open as unknown.
(allow lyra_parental_probe_t security_t (dir (search getattr read open)))
(allow lyra_parental_probe_t security_t (file (getattr read open)))

; Actual userspace mediation: same-domain session messages and manager env.
(allow lyra_parental_probe_t self (dbus (send_msg acquire_svc)))
(allow lyra_parental_probe_t self (system (reload)))

; selinuxfs access/create are request-response query files requiring write.
; Only computation is authorized: no setenforce, load_policy or setbool.
(allow lyra_parental_probe_t security_t (file (write)))
(allow lyra_parental_probe_t security_t (security (compute_av compute_create)))

; Computed socket label stays in this domain; own manager unit operations.
(allow lyra_parental_probe_t self (process (setsockcreate)))
(allow lyra_parental_probe_t systemd_unit_file_t (service (status start)))

; D-Bus activation subscribes to own manager and starts transient units.
; Execution restrictions continue to apply to their child processes.
(allow lyra_parental_probe_t self (system (status start)))
