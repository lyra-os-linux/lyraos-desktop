; The packaged setuid helper has a private domain, not upstream mount_t.
; It can mount FUSE only on dedicated document-portal mount-point labels.
; No generic command execution, filesystem writes, or policy management.
(type lyra_parental_fusermount_t)
(typeattributeset domain (lyra_parental_fusermount_t))
(roletype lyra_parental_r lyra_parental_fusermount_t)
(roletype system_r lyra_parental_fusermount_t)
(allow lyra_parental_probe_t fusermount_exec_t (file (execute)))
(allow lyra_parental_probe_t lyra_parental_fusermount_t (process (transition signal)))
(typetransition lyra_parental_probe_t fusermount_exec_t process lyra_parental_fusermount_t)
(allow lyra_parental_fusermount_t fusermount_exec_t (file (entrypoint execute read open getattr map)))
(allow lyra_parental_fusermount_t file_type (dir (search getattr)))
(allow lyra_parental_fusermount_t file_type (file (read open getattr map)))
(allow lyra_parental_fusermount_t file_type (lnk_file (read getattr)))
(allow lyra_parental_fusermount_t lib_t (file (execute)))
(allow lyra_parental_fusermount_t ld_so_t (file (execute)))
(allow lyra_parental_fusermount_t lyra_parental_probe_t (fd (use)))
(allow lyra_parental_fusermount_t lyra_parental_probe_t (process (sigchld)))
(allow lyra_parental_fusermount_t lyra_parental_probe_t (unix_stream_socket (read write getattr getopt)))
(allow lyra_parental_fusermount_t domain (fifo_file (read write getattr)))
(allow lyra_parental_fusermount_t file_type (fifo_file (read write getattr)))
(allow lyra_parental_fusermount_t self (capability (sys_admin setuid setgid dac_read_search)))
(allow lyra_parental_fusermount_t self (process (getattr)))
(allow lyra_parental_fusermount_t fuse_device_t (chr_file (read write open getattr ioctl)))
(allow lyra_parental_fusermount_t lyra_parental_document_mount_t (dir (read open write mounton)))
(allow lyra_parental_fusermount_t fusefs_t (filesystem (mount unmount getattr)))
(allow lyra_parental_fusermount_t tmpfs_t (filesystem (getattr)))
; The user manager can inspect and reap its helper without changing domain.
(allow lyra_parental_probe_t lyra_parental_fusermount_t (dir (search getattr)))
(allow lyra_parental_probe_t lyra_parental_fusermount_t (file (read open getattr)))
