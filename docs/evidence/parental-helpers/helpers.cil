; Recorder metadata is private, non-executable, and discarded with the runtime.
(type lyra_parental_screencast_cache_t)
(typeattributeset file_type (lyra_parental_screencast_cache_t))
(typetransition lyra_parental_screencast_t user_tmp_t dir "lyra-screencast-private" lyra_parental_screencast_cache_t)
(typetransition lyra_parental_screencast_t lyra_parental_screencast_cache_t file lyra_parental_screencast_cache_t)
