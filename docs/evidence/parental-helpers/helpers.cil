(allow lyra_parental_screencast_t lyra_parental_screencast_cache_t (file (create write append setattr unlink rename)))

; Fontconfig metadata stays in the same private, non-executable cache.
(allow lyra_parental_screencast_t lyra_parental_screencast_cache_t (file (link)))
(allow lyra_parental_screencast_t lyra_parental_screencast_cache_t (dir (rmdir)))
(allow lyra_parental_screencast_t fs_t (filesystem (getattr)))

; Gtk sends an O_RDWR cursor SHM descriptor to the trusted compositor.
; Only the compositor can receive/write it; the restricted account cannot.
(allow lyra_parental_shell_t lyra_parental_screencast_memory_t (file (write)))

; PipeWire verifies its peer's /proc root before granting access to the stream.
(allow lyra_parental_probe_t lyra_parental_screencast_t (lnk_file (read getattr)))
; Upstream stores its recorder blocklist via an atomic runtime-file rename.
(allow lyra_parental_screencast_t user_tmp_t (file (rename)))
(allow lyra_parental_screencast_t lyra_parental_screencast_cache_t (file (lock)))

; The trusted recorder receives the compositor's writable screen-cast memfd.
; Account applications still cannot write or execute this private type.
(allow lyra_parental_screencast_t lyra_parental_shell_memory_t (file (write)))
