; Experimental VM-only read/lock for ordinary account admission, no write grants.
(type lyra_cron_adapter_state_t)
(typeattributeset file_type (lyra_cron_adapter_state_t))
(allow crond_t lyra_cron_adapter_state_t (dir (getattr search open read)))
(allow crond_t lyra_cron_adapter_state_t (file (getattr open read lock)))
(allow init_t lyra_cron_adapter_state_t (dir (getattr search open read)))
(allow init_t lyra_cron_adapter_state_t (file (getattr open read lock)))
