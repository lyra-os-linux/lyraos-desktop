# Leap 16.1 plymouth 22.02.122+94: local copy with the runtime path resolved.
# A drop-in still makes systemd parse and warn about the invalid vendor path.
# Remove this override when the vendor unit uses an absolute PID-file path.
[Unit]
Description=Forward Password Requests to Plymouth
Documentation=http://www.freedesktop.org/wiki/Software/systemd/PasswordAgents
DefaultDependencies=no
Conflicts=shutdown.target
After=plymouth-start.service
Before=shutdown.target
ConditionKernelCommandLine=!plymouth.enable=0
ConditionVirtualization=!container
ConditionPathExists=/run/plymouth/pid

[Service]
ExecStart=/usr/bin/systemd-tty-ask-password-agent --watch --plymouth
