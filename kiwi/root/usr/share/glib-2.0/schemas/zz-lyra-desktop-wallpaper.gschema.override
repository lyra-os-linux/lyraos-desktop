# Lyra Desktop visual defaults. Keep this override after the theme package's
# defaults so the image has a release-owned, deterministic initial appearance.
# Users remain free to change these values normally in GNOME Settings.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/lyra/2702-dawn.png'
picture-uri-dark='file:///usr/share/backgrounds/lyra/2702-dawn.png'
