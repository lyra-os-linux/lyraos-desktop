# Enable Lyra's GNOME integration for the live session and newly-created users.
# This is a default, not a lock: users remain free to disable the extension.
[org.gnome.shell]
enabled-extensions=['dock@lyraos.com.br', 'panel@lyraos.com.br', 'menus@lyraos.com.br', 'search@lyraos.com.br', 'animations@lyraos.com.br', 'updates-indicator@lyraos.com.br', 'desktop-icons@lyraos.com.br']
